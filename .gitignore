# Autonomous Business Finance Platform - Root .gitignore

# Dependencies
node_modules/
*/node_modules/

# Build artifacts
dist/
*/dist/
dist-ssr/
build/

# Environment Variables & Secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
!*/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/
*/coverage/

# IDE and Operating System
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files
*.tmp
*.temp
.cache/
