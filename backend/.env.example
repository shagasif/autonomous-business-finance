# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (comma-separated origins or single origin)
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL with Prisma)
# Replace credentials with your PostgreSQL instance credentials
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_finance_dev?schema=public

# Database connection pool settings (optional)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
